        <Field Name="FNSPD">
          <DataField>FNSPD</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="LTVTempOut">
          <DataField>LTVTempOut</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
