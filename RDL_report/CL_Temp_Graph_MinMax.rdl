<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="BatchDB">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=SERVER1\INFSERVER;Initial Catalog=ASMBatchReports</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>9ab206bb-fb96-4825-a477-00b100614573</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="PM1Data">
      <Query>
        <DataSourceName>BatchDB</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BeginDate">
            <Value>=Parameters!BeginDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>Select
  Cast(PM1Data.[TimeStamp] as date) as TimeStamp
  ,datepart(HOUR, PM1Data.[TimeStamp]) as Hr
  ,PM1Data.FormulaName
  ,PM1Data.FormulaCode
  ,PM1Data.LTPH
  ,PM1Data.VLVPos
      ,PM1Data.MXTempSP
      ,PM1Data.MXTemp
      ,PM1Data.MXFDSPD
      ,PM1Data.CLTemp
      ,PM1Data.CLTempOut
      ,PM1Data.ATempIN
      ,PM1Data.ATempOut
      ,PM1Data.FNSPD
      ,PM1Data.LTVTempOut
FROM
   PM1Data
WHERE PM1Data.[TimeStamp] &gt;= @BeginDate
AND PM1Data.[TimeStamp] &lt;= DateAdd(DAy,1,@EndDate)
and FormulaCode &lt;&gt; '0'
Order by
PM1Data.[TimeStamp]</CommandText>
      </Query>
      <Fields>
        <Field Name="TimeStamp">
          <DataField>TimeStamp</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Hr">
          <DataField>Hr</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="FormulaName">
          <DataField>FormulaName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FormulaCode">
          <DataField>FormulaCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LTPH">
