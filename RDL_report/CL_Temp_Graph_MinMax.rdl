          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="CLTempOut">
          <DataField>CLTempOut</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="ATempIN">
